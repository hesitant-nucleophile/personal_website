# Ignore everything by default, then allow only what the website needs.
*
!.gitignore

# Custom domain for GitHub Pages (kongsbach.com) — must stay in the repo
!CNAME

# Let git look inside folders (e.g. CAMS/), so the rules below also apply there
!*/

# All pages (index, about, chromo, cryzt, extr, governor, header/footer partials, ...)
!*.html

# Code and styling
!style.css
!main.js

# Images used by the pages (everything in the images folder)
!images/
!images/**

# ...except unused favicon variants: only the ones the pages use are uploaded
images/favicon*.png
!images/favicon2.png
!images/favicon3.png
!images/favicon4.png

# Videos used by the pages
!videos/
!videos/**

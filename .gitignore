# Ignore everything by default, then allow only what the website needs.
*
!.gitignore

# All pages (index, about, chromo, cryzt, extr, governor, header/footer partials, ...)
!*.html

# Code and styling
!style.css
!main.js

# Images used by the pages
!favicon2.png
!favicon3.png
!profile.jpg

!images/
!images/**
